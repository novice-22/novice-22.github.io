---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import { SITE, VISITOR_API } from "../consts";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
}
const { title, description = SITE.description } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
---

<!doctype html>
<html lang="ko" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <!-- 모노: JetBrains Mono (코드·터미널 UI) -->
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- 한글 본문: Pretendard (동적 서브셋 — 쓰는 글자만 내려받음) -->
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <ClientRouter />
    <script is:inline define:vars={{ visitorApi: VISITOR_API }}>
      // FOUC 방지: 렌더 전 테마·사이드바 상태 적용
      (function () {
        var t = localStorage.getItem("theme") || "dark";
        document.documentElement.setAttribute("data-theme", t);
        var s = localStorage.getItem("sidebar") || "collapsed";
        document.documentElement.setAttribute("data-sidebar", s);
      })();
      // 방문자 카운터 Worker 주소를 전역에 노출 (모든 페이지에서 접근용).
      window.__VISITOR_API = visitorApi;
    </script>

    <!-- Cloudflare Web Analytics (방문자 통계) -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "9c98ffed405b42308810c86c0bd35a05"}'></script>
  </head>
  <body>
    <div class="edge-hover" aria-hidden="true" transition:persist></div>
    <button class="side-toggle" title="사이드바 고정/해제" aria-label="사이드바 고정/해제" transition:persist>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
        <line x1="9" y1="3" x2="9" y2="21"></line>
      </svg>
    </button>
    <div class="layout">
      <Sidebar />
      <main class="main">
        {!isHome && <a href="/" class="home-link">← 홈</a>}
        <slot />
        <footer>
          <span>© {new Date().getFullYear()} {SITE.title}</span>
          <span class="built">built with <span class="accent">Astro</span> + <span class="accent">Notion</span></span>
        </footer>
      </main>
    </div>

    <script>
      // View Transitions 대응: 지속 요소(사이드바·토글)엔 한 번만 바인딩,
      // 페이지마다 바뀌는 것(본문 복사버튼·메뉴 active)은 astro:page-load 에서 갱신.
      // 라이트박스 닫기 (ESC·바깥클릭·페이지 전환에서 공용으로 씀)
      function closeLightbox() {
        if (!window.__lb) return;
        window.__lb.remove();
        window.__lb = null;
        document.documentElement.style.overflow = "";
      }

      function syncTheme() {
        var t = document.documentElement.getAttribute("data-theme");
        document.querySelectorAll(".theme-toggle").forEach(function (b) {
          b.textContent = t === "dark" ? "[ dark ]" : "[ light ]";
        });
      }

      function bindOnce() {
        if (window.__uiBound) return;
        window.__uiBound = true;
        var docEl = document.documentElement;

        // 테마 토글
        document.addEventListener("click", function (e) {
          var btn = e.target.closest && e.target.closest(".theme-toggle");
          if (!btn) return;
          var next = docEl.getAttribute("data-theme") === "dark" ? "light" : "dark";
          docEl.setAttribute("data-theme", next);
          localStorage.setItem("theme", next);
          syncTheme();
        });

        // links 토글
        document.addEventListener("click", function (e) {
          var btn = e.target.closest && e.target.closest(".links-toggle");
          if (!btn) return;
          var box = document.getElementById("social-links");
          var open = btn.getAttribute("aria-expanded") === "true";
          btn.setAttribute("aria-expanded", open ? "false" : "true");
          if (box) box.hidden = open;
        });

        // 글 목록 정렬 드롭다운 (열기 / 선택 / 바깥 클릭 닫기) — 선택은 전역 저장
        var closeSort = function () {
          var menu = document.querySelector("[data-sortmenu]");
          if (!menu) return;
          var trg = menu.querySelector("[data-sort-trigger]");
          var list = menu.querySelector("[data-sort-list]");
          if (trg) trg.setAttribute("aria-expanded", "false");
          if (list) list.hidden = true;
        };
        document.addEventListener("click", function (e) {
          var trigger = e.target.closest && e.target.closest("[data-sort-trigger]");
          if (trigger) {
            var list = trigger.parentNode.querySelector("[data-sort-list]");
            var open = trigger.getAttribute("aria-expanded") === "true";
            trigger.setAttribute("aria-expanded", open ? "false" : "true");
            if (list) list.hidden = open;
            return;
          }
          var opt = e.target.closest && e.target.closest("[data-sort]");
          if (opt) {
            localStorage.setItem("sort", opt.getAttribute("data-sort"));
            applySort();
            closeSort();
            return;
          }
          if (!e.target.closest || !e.target.closest("[data-sortmenu]")) closeSort();
        });
        document.addEventListener("keydown", function (e) {
          if (e.key !== "Escape") return;
          closeSort();
          closeLightbox();
        });

        // 본문 이미지 클릭 확대 (라이트박스). 720px 본문 폭에 눌린 스크린샷을 원본으로 보기 위함.
        // 오버레이는 열 때 만들고 닫을 때 제거 → View Transitions 로 페이지가 바뀌어도 남지 않음.
        document.addEventListener("click", function (e) {
          var img = e.target.closest && e.target.closest(".prose img");
          if (!img) return;
          closeLightbox();
          var ov = document.createElement("div");
          ov.className = "lightbox";
          var btn = document.createElement("button");
          btn.className = "lb-close";
          btn.setAttribute("aria-label", "닫기");
          btn.textContent = "✕";
          var big = document.createElement("img");
          big.src = img.getAttribute("src");
          big.alt = img.getAttribute("alt") || "";
          ov.appendChild(btn);
          ov.appendChild(big);
          ov.addEventListener("click", closeLightbox);
          document.body.appendChild(ov);
          document.documentElement.style.overflow = "hidden"; // 뒤 배경 스크롤 잠금
          window.__lb = ov;
        });

        // 목차 접기/펴기 (화살표 클릭). 스크롤로 섹션이 바뀌면 자동 펼침이 다시 덮어씀.
        document.addEventListener("click", function (e) {
          var btn = e.target.closest && e.target.closest(".toc-toggle");
          if (!btn) return;
          var g = btn.closest(".toc-group");
          if (!g) return;
          var open = g.getAttribute("data-open") === "true";
          g.setAttribute("data-open", open ? "false" : "true");
          btn.setAttribute("aria-expanded", open ? "false" : "true");
        });

        // 카테고리 하위 분야 아코디언 (화살표 클릭 = 펼침/접힘, 이름 클릭 = 전체글 이동)
        document.addEventListener("click", function (e) {
          var btn = e.target.closest && e.target.closest(".cat-toggle");
          if (!btn) return;
          var group = btn.closest(".cat-group");
          var open = group.getAttribute("data-open") === "true";
          group.setAttribute("data-open", open ? "false" : "true");
          btn.setAttribute("aria-expanded", open ? "false" : "true");
        });

        // 사이드바 peek / 핀 고정 (사이드바·토글·edge 는 transition:persist 로 유지됨)
        var sidebar = document.querySelector(".sidebar");
        var toggle = document.querySelector(".side-toggle");
        var edge = document.querySelector(".edge-hover");
        if (sidebar) {
          var hideTimer;
          var pinned = function () { return docEl.getAttribute("data-sidebar") === "open"; };
          var syncPin = function () { if (toggle) toggle.classList.toggle("pinned", pinned()); };
          var show = function () { clearTimeout(hideTimer); sidebar.classList.add("peek"); };
          var scheduleHide = function () {
            clearTimeout(hideTimer);
            hideTimer = setTimeout(function () {
              if (pinned()) return;
              if (sidebar.contains(document.activeElement)) return;
              sidebar.classList.remove("peek");
            }, 180);
          };
          if (edge) edge.addEventListener("mouseenter", show);
          if (toggle) {
            toggle.addEventListener("mouseenter", show);
            toggle.addEventListener("mouseleave", scheduleHide);
            toggle.addEventListener("click", function () {
              var next = pinned() ? "collapsed" : "open";
              docEl.setAttribute("data-sidebar", next);
              localStorage.setItem("sidebar", next);
              syncPin();
              if (next === "open") show();
            });
          }
          sidebar.addEventListener("mouseenter", show);
          sidebar.addEventListener("mouseleave", scheduleHide);
          sidebar.addEventListener("focusout", scheduleHide);
          syncPin();

          // 사이드바(오버레이) 위에서 휠 스크롤이 뒤 메인 페이지로 넘어가지 않게.
          // 사이드바가 더 스크롤할 게 없으면 휠 입력을 흡수(preventDefault)한다.
          // 모바일 스택 레이아웃에선 사이드바가 문서 흐름 안이라 정상 스크롤 허용.
          var sbBody = sidebar.querySelector(".sidebar-body");
          sidebar.addEventListener("wheel", function (e) {
            if (!window.matchMedia("(min-width: 881px)").matches) return;
            var el = sbBody || sidebar;
            var canScroll = el.scrollHeight > el.clientHeight + 1;
            var atTop = el.scrollTop <= 0;
            var atBottom = el.scrollTop + el.clientHeight >= el.scrollHeight - 1;
            if (!canScroll || (e.deltaY < 0 && atTop) || (e.deltaY > 0 && atBottom)) {
              e.preventDefault();
            }
          }, { passive: false });

          // 검색 (Pagefind 실시간 드롭다운)
          var input = document.getElementById("site-search");
          var resBox = document.getElementById("site-search-results");
          if (input && resBox) {
            var pf = null, timer = null;
            var pfUrl = "/pagefind/" + "pagefind.js";
            var loadPF = function () {
              if (pf) return Promise.resolve(pf);
              return import(/* @vite-ignore */ pfUrl).then(function (m) {
                pf = m; if (pf.options) pf.options({ excerptLength: 20 }); return pf;
              }).catch(function () { return null; });
            };
            var esc = function (s) { var d = document.createElement("div"); d.textContent = s == null ? "" : s; return d.innerHTML; };
            var renderRes = function (items, q) {
              if (!items.length) { resBox.innerHTML = '<div class="sb-sr-empty">‘' + esc(q) + '’ 검색 결과가 없어요</div>'; resBox.hidden = false; return; }
              resBox.innerHTML = items.map(function (r) {
                return '<a class="sb-sr-item" href="' + esc(r.url) + '"><span class="sb-sr-title">' + esc(r.meta && r.meta.title ? r.meta.title : r.url) + '</span><span class="sb-sr-ex">' + (r.excerpt || "") + '</span></a>';
              }).join("");
              resBox.hidden = false;
            };
            var doSearch = function (q) {
              loadPF().then(function (p) {
                if (!p) { resBox.innerHTML = '<div class="sb-sr-empty">검색은 배포된 사이트에서 동작해요</div>'; resBox.hidden = false; return; }
                p.search(q).then(function (res) { Promise.all(res.results.map(function (r) { return r.data(); })).then(function (items) { renderRes(items, q); }); });
              });
            };
            input.addEventListener("input", function () {
              var q = input.value.trim(); clearTimeout(timer);
              if (!q) { resBox.hidden = true; resBox.innerHTML = ""; return; }
              timer = setTimeout(function () { doSearch(q); }, 200);
            });
            input.addEventListener("focus", loadPF);
            document.addEventListener("click", function (e) { if (!e.target.closest || !e.target.closest(".sb-search")) resBox.hidden = true; });
            input.addEventListener("keydown", function (e) { if (e.key === "Escape") { resBox.hidden = true; input.blur(); } });
          }
        }
      }

      // 글 목록(.feed)을 저장된 선택 기준으로 재정렬 + 순번(.e-num) 갱신.
      // DOM은 안 옮기고 CSS order 로만 재배치 → 등장 애니메이션이 다시 안 걸림.
      // data-date(타임스탬프)를 키로 사용. 정렬 메뉴가 없는 페이지(홈 등)는 건너뜀.
      function applySort() {
        var menu = document.querySelector("[data-sortmenu]");
        var feed = document.querySelector(".feed");
        if (!menu || !feed) return;
        var pref = localStorage.getItem("sort") || "newest";
        var items = Array.prototype.slice.call(feed.querySelectorAll(".entry"));
        var ordered = items.slice().sort(function (a, b) {
          var da = +a.getAttribute("data-date") || 0;
          var db = +b.getAttribute("data-date") || 0;
          return pref === "oldest" ? da - db : db - da;
        });
        // 번호(.e-num)는 각 글에 고정 — 재매김하지 않고 flex order 로 위치만 바꾼다.
        ordered.forEach(function (el, i) {
          el.style.order = i;
        });
        var label = menu.querySelector("[data-sort-label]");
        if (label) label.textContent = pref === "oldest" ? "오래된순" : "최신순";
        menu.querySelectorAll("[data-sort]").forEach(function (b) {
          b.classList.toggle("active", b.getAttribute("data-sort") === pref);
        });
      }

      // 방문자 수 — 홈에만 있는 [data-visitors] 영역을 Cloudflare Worker 값으로 갱신.
      // 모든 페이지 로드(전환 포함)에서 호출되므로, 어느 페이지로 들어와 홈으로 와도 동작한다.
      // 중복 방문 판별은 Worker(IP+UA 해시)가 처리. 세션 첫 방문만 POST /visit, 이후 GET /stats.
      function initVisitors() {
        var api = window.__VISITOR_API;
        if (!api || !document.querySelector('[data-visitors="total"]')) return;
        var visited = sessionStorage.getItem("visited") === "1";
        fetch(api + (visited ? "/stats" : "/visit"), { method: visited ? "GET" : "POST" })
          .then(function (r) { return r.json(); })
          .then(function (s) {
            sessionStorage.setItem("visited", "1");
            var t = document.querySelector('[data-visitors="total"]');
            var to = document.querySelector('[data-visitors="today"]');
            if (t) t.textContent = (s.total || 0).toLocaleString("en-US");
            if (to) to.textContent = (s.today || 0).toLocaleString("en-US");
          })
          .catch(function () {});
      }

      // 목차 스크롤스파이 — "화면 상단 기준선(110px)을 마지막으로 지난 헤딩"을 현재 섹션으로 본다.
      // 위치 계산 방식이라 목차를 클릭해 점프했을 때도 그 항목이 정확히 활성화된다.
      // (IntersectionObserver 감시 구간 방식은 점프한 헤딩이 구간 위로 올라가 활성화가 안 됐음)
      // 페이지 전환마다 이전 리스너를 떼어 누수를 막는다.
      var __tocCleanup = null;
      function initToc() {
        if (__tocCleanup) { __tocCleanup(); __tocCleanup = null; }
        var toc = document.querySelector(".toc");
        if (!toc) return;
        var links = Array.prototype.slice.call(toc.querySelectorAll('a[href^="#"]'));
        // 목차에 h1~h6 를 모두 넣으므로 감시 대상도 전부여야 한다.
        // (h2/h3 만 보면 번호 섹션이 h1 인 글에서 활성 표시가 안 따라감)
        var heads = Array.prototype.slice.call(
          document.querySelectorAll(
            ".prose h1[id], .prose h2[id], .prose h3[id], .prose h4[id], .prose h5[id], .prose h6[id]"
          )
        );
        if (!links.length || !heads.length) return;

        var byId = {};
        links.forEach(function (a) {
          byId[decodeURIComponent(a.getAttribute("href").slice(1))] = a;
        });

        var LINE = 110;
        var active = null;
        var update = function () {
          var cur = heads[0];
          for (var i = 0; i < heads.length; i++) {
            if (heads[i].getBoundingClientRect().top <= LINE) cur = heads[i];
            else break;
          }
          var a = byId[cur.id] || null;
          if (a === active) return;
          if (active) active.classList.remove("active");
          if (a) a.classList.add("active");
          active = a;

          // 현재 섹션만 펼치고 나머지는 접어서 목차 높이를 최소로 유지
          var here = a ? a.closest(".toc-group") : null;
          toc.querySelectorAll(".toc-group").forEach(function (g) {
            var open = g === here;
            g.setAttribute("data-open", open ? "true" : "false");
            var t = g.querySelector(".toc-toggle");
            if (t) t.setAttribute("aria-expanded", open ? "true" : "false");
          });
        };

        var ticking = false;
        var onScroll = function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () { ticking = false; update(); });
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        update();
        __tocCleanup = function () {
          window.removeEventListener("scroll", onScroll);
          window.removeEventListener("resize", onScroll);
        };
      }

      function perPage() {
        syncTheme();
        applySort();
        initVisitors();
        initToc();
        // 사이드바가 유지되므로 현재 경로 기준으로 메뉴 active 갱신
        var path = location.pathname.replace(/\/$/, "") || "/";
        document.querySelectorAll(".nav-block a").forEach(function (a) {
          var href = a.getAttribute("href");
          var active = href === "/" ? path === "/" : path.indexOf(href) === 0;
          a.classList.toggle("active", active);
        });
        // 현재 카테고리 그룹은 자동으로 펼침
        document.querySelectorAll(".cat-group").forEach(function (g) {
          var link = g.querySelector(".cat-parent-link");
          if (link && path.indexOf(link.getAttribute("href")) === 0) {
            g.setAttribute("data-open", "true");
            var tg = g.querySelector(".cat-toggle");
            if (tg) tg.setAttribute("aria-expanded", "true");
          }
        });
        // 코드블록 복사 버튼 (본문은 페이지마다 새로 로드됨)
        document.querySelectorAll(".prose pre").forEach(function (pre) {
          if (pre.querySelector(".copy-btn")) return;
          var btn = document.createElement("button");
          btn.className = "copy-btn";
          btn.textContent = "copy";
          btn.addEventListener("click", function () {
            var code = pre.querySelector("code");
            var text = code ? code.innerText : pre.innerText;
            navigator.clipboard.writeText(text).then(function () {
              btn.textContent = "copied";
              btn.classList.add("copied");
              setTimeout(function () { btn.textContent = "copy"; btn.classList.remove("copied"); }, 1500);
            });
          });
          pre.appendChild(btn);
        });
      }

      // 전환 시 사이드바 내부 스크롤 위치 보존 (persist 요소는 DOM 이동 때 scrollTop 이 초기화됨)
      var __sbScroll = 0;
      document.addEventListener("astro:before-swap", function () {
        closeLightbox(); // 전환 중 오버레이가 남지 않게
        var sb = document.querySelector(".sidebar-body");
        if (sb) __sbScroll = sb.scrollTop;
      });
      document.addEventListener("astro:after-swap", function () {
        // 전환 시 html 속성이 새 페이지 기준으로 초기화되므로 테마·사이드바를
        // localStorage 기준으로 다시 적용 (테마가 페이지마다 리셋되지 않게).
        var t = localStorage.getItem("theme") || "dark";
        document.documentElement.setAttribute("data-theme", t);
        var s = localStorage.getItem("sidebar") || "collapsed";
        document.documentElement.setAttribute("data-sidebar", s);
        var sb = document.querySelector(".sidebar-body");
        if (sb) sb.scrollTop = __sbScroll;
      });

      document.addEventListener("astro:page-load", function () {
        bindOnce();
        perPage();
      });
    </script>
  </body>
</html>
